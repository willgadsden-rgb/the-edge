# The Edge — secrets template (Phase 4, live Form King data).
#
# HOW TO USE
#   1. Copy this file to `.streamlit/secrets.toml` (that real file is
#      gitignored and must NEVER be committed or shared).
#   2. Fill in your Form King values below and set DATA_SOURCE = "live".
#   3. On Streamlit Community Cloud, do NOT upload secrets.toml — instead paste
#      these same keys into  Manage app → Settings → Secrets.
#
# Leave DATA_SOURCE = "mock" (or omit everything) to keep the app on mock data
# with no outbound API calls — the Phase 1-3 behaviour.

# "mock" (default) or "live"
DATA_SOURCE = "mock"

# Form King API — confirm these against the Form King API docs.
FORMKING_BASE_URL = "https://api.formking.com.au"   # base URL, no trailing path
FORMKING_API_KEY  = "paste-your-secret-key-here"    # secret — never commit
FORMKING_AUTH_HEADER = "X-API-Key"                  # header the key is sent in
